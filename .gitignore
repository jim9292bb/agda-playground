node_modules

# build output
/build
/.svelte-kit

# env
.env
.env.*
!.env.sample

# Vite
vite.config.js.timestamp-*

# Local deploy configuration — created from deploy.config.example.json by
# ensure-deploy-config.mjs (runs automatically before dev/check/build).
# Contains OS-specific paths (agdaLibPath) that vary per machine; not committed.
/deploy.config.json

# Deploy staging area — libraries, ALS builds, .agdai cache (populated by
# `npm run auto-configure` / `npm run install-als` / `npm run build-agdai`
# or placed by hand — see DEPLOYMENT.md). Packaged into static/ by
# `npm run setup` — none of this is committed.
# Note: agdaiDir in deploy.config.json can point outside this directory;
# such paths must be gitignored by the deployer.
/.deploy-assets/
/static/library/
/static/als/

# Generated from the real .agda-lib files (see
# scripts/generate-library-info.mjs) — not committed.
/scripts/generated-libraries.mjs
/scripts/generated-als-info.mjs

/experiments/build-library/results/*.zip

# Extracted .agdai files for on-demand serving (copied by npm run setup from
# a placed/fetched _build/ tree — see DEPLOYMENT.md)
/static/agdai/
