{
  "name": "agda-playground",
  "version": "0.0.1",
  "description": "Browser-hosted single-file Agda playground for demonstrations, learning, and practice",
  "author": "qbane",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-graph-als.mjs",
    "presetup": "node scripts/generate-manifest.mjs",
    "setup": "scripts/setup-assets.sh",
    "auto-configure": "node scripts/auto-configure.mjs",
    "generate-manifest": "node scripts/generate-manifest.mjs",
    "build-agdai": "node scripts/build-agdai.mjs",
    "agdai-status": "node scripts/check-agdai-status.mjs",
    "predev": "node scripts/ensure-deploy-config.mjs && node scripts/generate-library-info.mjs && node scripts/generate-agdai-keys.mjs && node scripts/generate-als-info.mjs && node scripts/generate-plfa-chapters.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/ensure-deploy-config.mjs && node scripts/generate-library-info.mjs && node scripts/generate-agdai-keys.mjs && node scripts/generate-als-info.mjs && node scripts/generate-plfa-chapters.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "experiment:runtime-fs": "npm --prefix experiments/runtime-fs run benchmark --",
    "prepare": "svelte-kit sync || true",
    "svelte-kit-sync": "svelte-kit sync && rm -f node_modules/.tmp/*.tsbuildinfo",
    "tsc": "tsc -b",
    "precheck": "node scripts/ensure-deploy-config.mjs && node scripts/generate-library-info.mjs && node scripts/generate-agdai-keys.mjs && node scripts/generate-als-info.mjs && node scripts/generate-plfa-chapters.mjs",
    "check": "npm run svelte-kit-sync && svelte-check --tsconfig ./tsconfigs/tsconfig.app.json",
    "precheck:watch": "node scripts/ensure-deploy-config.mjs && node scripts/generate-library-info.mjs && node scripts/generate-agdai-keys.mjs && node scripts/generate-als-info.mjs && node scripts/generate-plfa-chapters.mjs",
    "check:watch": "npm run svelte-kit-sync && svelte-check --tsconfig ./tsconfigs/tsconfig.app.json --watch",
    "lint:deps": "knip",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:browser": "npm run test:browser:core-commands && npm run test:browser:goal-lifecycle && npm run test:browser:damaged-goals && npm run test:browser:load-state && npm run test:browser:commands-panel && npm run test:browser:settings && npm run test:browser:shortcut-overrides && npm run test:browser:auto && npm run test:browser:queries && npm run test:browser:command-input && npm run test:browser:goal-details && npm run test:browser:libraries && npm run test:browser:library-cache-profile && npm run test:browser:agda-categories && npm run test:browser:errors && npm run test:browser:examples && npm run test:browser:unicode-input && npm run test:browser:unicode-lookup && npm run test:browser:restart-worker-reuse && npm run test:browser:refine-intro && npm run test:browser:give-embedded-goal && npm run test:browser:case-split-extended-lambda && npm run test:browser:module-contents-submodules && npm run test:browser:goal-type-and-compute && npm run test:browser:search-about-alignment && npm run test:browser:goal-navigation && npm run test:browser:implicit-irrelevant-args && npm run test:browser:running-info-debug-level && npm run test:browser:compute-infer-toplevel && npm run test:browser:messages-tab-auto-switch && npm run test:browser:plfa-chapter-deep-link",
    "test:browser:core-commands": "scripts/browser-test-core-commands.sh",
    "test:browser:plfa-chapter-deep-link": "scripts/browser-test-plfa-chapter-deep-link.sh",
    "test:browser:implicit-irrelevant-args": "scripts/browser-test-implicit-irrelevant-args.sh",
    "test:browser:running-info-debug-level": "scripts/browser-test-running-info-debug-level.sh",
    "test:browser:compute-infer-toplevel": "scripts/browser-test-compute-infer-toplevel.sh",
    "test:browser:messages-tab-auto-switch": "scripts/browser-test-messages-tab-auto-switch.sh",
    "test:browser:refine-intro": "scripts/browser-test-refine-intro.sh",
    "test:browser:give-embedded-goal": "scripts/browser-test-give-embedded-goal.sh",
    "test:browser:case-split-extended-lambda": "scripts/browser-test-case-split-extended-lambda.sh",
    "test:browser:module-contents-submodules": "scripts/browser-test-module-contents-submodules.sh",
    "test:browser:goal-type-and-compute": "scripts/browser-test-goal-type-and-compute.sh",
    "test:browser:search-about-alignment": "scripts/browser-test-search-about-alignment.sh",
    "test:browser:goal-navigation": "scripts/browser-test-goal-navigation.sh",
    "test:browser:goal-lifecycle": "scripts/browser-test-goal-lifecycle.sh",
    "test:browser:damaged-goals": "scripts/browser-test-damaged-goal-boundaries.sh",
    "test:browser:load-state": "scripts/browser-test-load-state-refresh.sh",
    "test:browser:commands-panel": "scripts/browser-test-commands-panel.sh",
    "test:browser:settings": "scripts/browser-test-settings-dialog.sh",
    "test:browser:shortcut-overrides": "scripts/browser-test-shortcut-overrides.sh",
    "test:browser:auto": "scripts/browser-test-auto.sh",
    "test:browser:queries": "scripts/browser-test-query-shortcuts.sh",
    "test:browser:command-input": "scripts/browser-test-command-input-panel.sh",
    "test:browser:goal-details": "scripts/browser-test-goal-details.sh",
    "test:browser:libraries": "scripts/browser-test-library-loads.sh",
    "test:browser:library-cache-profile": "scripts/browser-test-library-cache-profile.sh",
    "test:browser:agda-categories": "scripts/browser-test-agda-categories-smoke.sh",
    "test:browser:errors": "scripts/browser-test-error-display.sh",
    "test:browser:examples": "scripts/browser-test-example-picker.sh",
    "test:browser:unicode-input": "scripts/browser-test-unicode-input.sh",
    "test:browser:unicode-lookup": "scripts/browser-test-unicode-lookup.sh",
    "test:browser:restart-worker-reuse": "scripts/browser-test-restart-worker-reuse.sh",
    "test:browser:literate-basic": "scripts/browser-test-literate-basic.sh",
    "test:browser:literate-truncation": "scripts/browser-test-literate-truncation.sh",
    "test:browser:literate-cells-crud": "scripts/browser-test-literate-cells-crud.sh",
    "test:browser:literate-cell-sync-race": "scripts/browser-test-literate-cell-sync-race.sh",
    "test:browser:literate-hover": "scripts/browser-test-literate-hover.sh",
    "test:browser:literate-goal-navigation": "scripts/browser-test-literate-goal-navigation.sh",
    "test:browser:plfa-basic": "scripts/browser-test-plfa-basic.sh",
    "test:browser:plfa-hover": "scripts/browser-test-plfa-hover.sh",
    "test:browser:plfa-goal-navigation": "scripts/browser-test-plfa-goal-navigation.sh",
    "test:browser:plfa-chapter-switching": "scripts/browser-test-plfa-chapter-switching.sh",
    "test:browser:plfa-cross-chapter-import": "scripts/browser-test-plfa-cross-chapter-import.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/kit": "^2.53.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "knip": "^6.17.1",
    "svelte": "^5.53.8",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0 <25.0.0"
  },
  "dependencies": {
    "@agda-web/browser_wasi_shim": "https://github.com/jim9292bb/agda-playground/releases/download/deps/agda-web-browser_wasi_shim-0.4.2.tgz",
    "@andy0130tw/vscode-jsonrpc-esm": "^9.0.0-next-esm.9",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lsp-client": "^6.2.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@lezer/highlight": "^1.2.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "codemirror": "6.0.2",
    "comlink": "^4.4.2",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "markdown-it-texmath": "^1.0.0",
    "spsc": "^0.0.7",
    "vscode-languageserver-protocol": "^3.17.5",
    "zod": "^4.3.6"
  }
}
